<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:FirewallReview.Desktop" x:Class="FirewallReview.Desktop.MainWindow" x:DataType="vm:MainViewModel" Title="Firewall Rule Review" Width="1280" Height="820" MinWidth="950" MinHeight="620">
<LayoutTransformControl><LayoutTransformControl.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/></LayoutTransformControl.LayoutTransform><Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24">
<Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Firewall Rule Review" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding Filename}" Margin="0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBox Text="{Binding Site}" Watermark="Site name" Width="170"/><ComboBox ItemsSource="{Binding VendorOptions}" SelectedIndex="{Binding VendorIndex}" Width="150"/><Button Content="Open evidence" Click="OpenPolicies" IsEnabled="{Binding !IsBusy}"/><Button Content="Export Excel" Click="ExportExcel" IsEnabled="{Binding HasReport}"/><Button Content="Export JSON" Click="ExportJson" IsEnabled="{Binding HasReport}"/><Button Content="Theme" Click="ToggleTheme"/></StackPanel></Grid>
<UniformGrid Grid.Row="1" Columns="4" Margin="0,12"><Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16" Margin="0,0,10,0" CornerRadius="8"><StackPanel><TextBlock Text="Total policies"/><TextBlock Text="{Binding Total}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border><Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16" Margin="0,0,10,0" CornerRadius="8"><StackPanel><TextBlock Text="High risk"/><TextBlock Text="{Binding High}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border><Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16" Margin="0,0,10,0" CornerRadius="8"><StackPanel><TextBlock Text="Medium risk"/><TextBlock Text="{Binding Medium}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border><Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16" CornerRadius="8"><StackPanel><TextBlock Text="Low risk"/><TextBlock Text="{Binding Low}" FontSize="26" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid>
<StackPanel Grid.Row="2" Margin="0,0,0,12"><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" MaxHeight="70" Margin="0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Grid ColumnDefinitions="260,12,*"><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" HorizontalAlignment="Stretch"/><TextBox Grid.Column="2" Watermark="Filter policy names, addresses or services" Text="{Binding Search}"/></Grid></StackPanel>
<TabControl Grid.Row="3" Name="ReviewTabs" SelectedIndex="2">
<TabItem Header="Policy scan"><Grid ColumnDefinitions="3*,16,*"><DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="90"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="80"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="140"/><DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="120"/><DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="85"/></DataGrid.Columns></DataGrid><TabControl Grid.Column="2"><TabItem Header="Rule evidence"><TextBox Text="{Binding SelectedRule.Evidence}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/></TabItem><TabItem Header="Benchmarks"><Grid RowDefinitions="Auto,*"><TextBlock Text="{Binding ConfigurationEvidence}" TextWrapping="Wrap" Margin="0,10"/><DataGrid Grid.Row="1" ItemsSource="{Binding Benchmarks}" AutoGenerateColumns="True"/></Grid></TabItem></TabControl></Grid>
</TabItem>
<TabItem Header="Compliance">
<Grid RowDefinitions="Auto,Auto,110,*" Margin="0,8">
<StackPanel><TextBlock Text="{Binding AuditSummary}" FontWeight="SemiBold"/><TextBlock Text="{Binding AuditScope}" TextWrapping="Wrap" FontSize="12" Margin="0,4"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12"><ComboBox ItemsSource="{Binding FrameworkOptions}" SelectedItem="{Binding SelectedFramework}" Width="380"/><ComboBox ItemsSource="{Binding AuditStatusOptions}" SelectedItem="{Binding SelectedAuditStatus}" Width="220"/></StackPanel>
<DataGrid Grid.Row="2" ItemsSource="{Binding FrameworkSummaries}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
<DataGridTextColumn Header="Framework" Binding="{Binding Framework}" Width="*"/><DataGridTextColumn Header="Findings" Binding="{Binding Findings}"/><DataGridTextColumn Header="No finding" Binding="{Binding NoFinding}"/><DataGridTextColumn Header="Needs evidence" Binding="{Binding NeedsEvidence}"/><DataGridTextColumn Header="Manual review" Binding="{Binding ManualReview}"/>
</DataGrid.Columns></DataGrid>
<Grid Grid.Row="3" ColumnDefinitions="3*,12,2*">
<DataGrid ItemsSource="{Binding ComplianceRows}" SelectedItem="{Binding SelectedAudit}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns>
<DataGridTextColumn Header="Framework" Binding="{Binding Framework}" Width="180"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="150"/><DataGridTextColumn Header="Check" Binding="{Binding Title}" Width="200"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
</DataGrid.Columns></DataGrid>
<TextBox Grid.Column="2" Text="{Binding AuditDetail}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
</Grid></Grid></TabItem>
<TabItem Header="Required evidence"><Grid RowDefinitions="Auto,*" Margin="0,10"><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Save CSV template" Click="SaveTemplate"/><TextBlock Text="Select Palo Alto or Fortinet above before saving a template." VerticalAlignment="Center"/></StackPanel><TextBox Grid.Row="1" Margin="0,12" Text="{Binding RequiredEvidence}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
</TabControl>
<Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,12,0,0"><TextBlock Text="{Binding Status}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="120"/><Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/><TextBlock Text="By Yash Nalawde" VerticalAlignment="Center" FontSize="11"/></StackPanel></Grid>
</Grid></LayoutTransformControl></Window>
